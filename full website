.site-section { padding: var(--section-pad-y) 0; }
.site-section-bleed { padding: var(--section-pad-y) var(--section-pad-x); }
.site-footer {
  padding: var(--space-6) var(--section-pad-x); display: flex; justify-content: space-between;
  flex-wrap: wrap; gap: var(--space-4); font-size: 13px;
  color: color-mix(in srgb, var(--color-text) 70%, transparent);
}

/* — type — */
.site-lede { font-size: var(--text-lede); line-height: 1.6; max-width: 52ch; color: color-mix(in srgb, var(--color-text) 82%, transparent); }
.site-subhead { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: var(--text-h3); margin: 0; }
.site-eyebrow-gap { margin: var(--space-3) 0 var(--space-4); }

/* — hero + media — */
.site-hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-6); align-items: center; padding: var(--space-8) 0 var(--space-6); }
.site-figure { margin: 0; border-radius: var(--radius-xl); overflow: hidden; }
.site-media-4x3 { position: relative; aspect-ratio: 4/3; border-radius: var(--radius-xl); overflow: hidden; background: var(--color-accent-2-100); }
.site-media-4x3 img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.9) contrast(0.95); }

/* — panels + CTA band — */
.site-panel { border-radius: var(--radius-xl); padding: var(--space-6) clamp(24px, 4vw, 64px); background: var(--color-surface); }
.site-panel-accent { background: var(--color-accent-2-100); }
.site-cta { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; }

/* — grids — */
.site-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
.site-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }

