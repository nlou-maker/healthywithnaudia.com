*{box-sizing:border-box}
input,select,textarea{font-family:inherit}
</style>
</head>
<body class="site-page" style="display:flex;flex-direction:column">

<nav class="nav" style="padding-inline:clamp(20px,5vw,72px);position:sticky;top:0;z-index:40;background:var(--color-bg)">
  <span class="nav-brand" style="display:flex;align-items:baseline;gap:5px;margin-right:auto;font-family:'Unbounded',system-ui,sans-serif">
    <span style="font-size:18px;font-weight:700;letter-spacing:-0.01em">Healthy</span>
    <span style="font-size:9px;font-weight:600;color:var(--color-accent-2-600)">with</span>
    <span style="font-size:12px;font-weight:600;color:var(--color-accent-700)">Naudia</span>
  </span>
  <a href="home.html">Home</a>
  <a href="services.html">Programs</a>
  <a href="about.html">About</a>
  <a href="contact.html">Contact</a>
  <a class="btn btn-primary" href="book.html" aria-current="page" style="color:var(--color-bg)">Book a Call</a>
</nav>

<main style="flex:1;padding:var(--space-8) clamp(20px,5vw,72px)"><a id="top"></a>

  <div style="position:relative;max-width:1040px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:var(--space-8);align-items:start">

    <div>
      <span class="tag tag-accent-2">FREE · NO PRESSURE</span>
      <h1 style="font-size:clamp(36px,4.5vw,58px);line-height:1.08;text-wrap:balance;margin:var(--space-4) 0 0">Let's start with a conversation.</h1>
      <p style="font-size:18px;line-height:1.6;margin:var(--space-4) 0 0;color:color-mix(in srgb, var(--color-text) 72%, transparent)">A free 30-minute Google Meet call. Bring your goals, leave with clarity.</p>
      <div style="height:1px;background:color-mix(in srgb, var(--color-text) 12%, transparent);margin:32px 0"></div>
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px">
        <li style="display:flex;gap:12px;font-size:15px;line-height:1.5"><span style="flex:0 0 auto;width:22px;height:22px;border-radius:999px;background:rgb(232,238,237);color:rgb(44,74,69);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center">1</span>Pick a time that fits your week</li>
        <li style="display:flex;gap:12px;font-size:15px;line-height:1.5"><span style="flex:0 0 auto;width:22px;height:22px;border-radius:999px;background:rgb(232,238,237);color:rgb(44,74,69);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center">2</span>Get your Google Meet link by email</li>
        <li style="display:flex;gap:12px;font-size:15px;line-height:1.5"><span style="flex:0 0 auto;width:22px;height:22px;border-radius:999px;background:rgb(232,238,237);color:rgb(44,74,69);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center">3</span>Tell me what you want to change or anything else you are struggling with</li>
      </ul>
      <p style="font-size:14px;line-height:1.6;margin:32px 0 0;color:color-mix(in srgb, var(--color-text) 55%, transparent)">Prefer to write first? <a href="contact.html" style="font-weight:600;border-bottom:1px solid rgba(44,74,69,0.35)">Send a message instead</a>.</p>
    </div>

    <div>
      <!-- STEP 1: pick a time -->
      <div id="step-time" style="background:var(--color-surface);border:1px solid color-mix(in srgb, var(--color-text) 10%, transparent);border-radius:calc(2 * var(--radius-lg));padding:var(--space-6);box-shadow:var(--shadow-md)">
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:24px">
          <h2 style="font-size:21px">Pick a time</h2>
          <span style="font-size:13px;font-weight:600;color:color-mix(in srgb, var(--color-text) 50%, transparent);white-space:nowrap">Berlin time (CEST)</span>
        </div>
        <div id="slots-container"></div>
      </div>

      <!-- STEP 2: details form -->
      <div id="step-details" hidden style="background:var(--color-surface);border:1px solid color-mix(in srgb, var(--color-text) 10%, transparent);border-radius:calc(2 * var(--radius-lg));padding:var(--space-6);box-shadow:var(--shadow-md)">
        <div id="selected-time-display" style="background:var(--color-accent-100);border-radius:var(--radius-lg);padding:14px 18px;font-size:15px;font-weight:600;color:var(--color-accent-800)"></div>
        <button type="button" id="change-time-btn" style="background:none;border:0;padding:0;margin-top:12px;color:var(--color-accent-2-600);font-family:var(--font-body);font-size:14px;font-weight:600;text-decoration:underline;cursor:pointer">Choose a different time</button>

        <h2 style="font-size:22px;margin-top:var(--space-6)">Your details</h2>
        <form id="booking-form" style="display:flex;flex-direction:column;gap:16px;margin-top:20px">
          <div style="display:flex;flex-direction:column;gap:6px">
            <label for="name" style="font-size:13px;font-weight:700">Name</label>
            <input type="text" id="name" required autocomplete="name" style="width:100%;padding:12px 14px;border:1px solid color-mix(in srgb, var(--color-text) 14%, transparent);border-radius:var(--radius-sm);font-size:15px;background:var(--color-bg);color:var(--color-text)">
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <label for="email" style="font-size:13px;font-weight:700">Email</label>
            <input type="email" id="email" required autocomplete="email" style="width:100%;padding:12px 14px;border:1px solid color-mix(in srgb, var(--color-text) 14%, transparent);border-radius:var(--radius-sm);font-size:15px;background:var(--color-bg);color:var(--color-text)">
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <div style="display:flex;flex-direction:column;gap:6px">
              <label for="age" style="font-size:13px;font-weight:700">Age</label>
              <input type="number" id="age" min="1" max="120" style="width:100%;padding:12px 14px;border:1px solid color-mix(in srgb, var(--color-text) 14%, transparent);border-radius:var(--radius-sm);font-size:15px;background:var(--color-bg);color:var(--color-text)">
            </div>
            <div style="display:flex;flex-direction:column;gap:6px">
              <label for="gender" style="font-size:13px;font-weight:700">Gender</label>
              <select id="gender" style="width:100%;padding:12px 14px;border:1px solid color-mix(in srgb, var(--color-text) 14%, transparent);border-radius:var(--radius-sm);font-size:15px;background:var(--color-bg);color:var(--color-text)">
                <option value="">Prefer not to say</option>
                <option value="Female">Female</option>
                <option value="Male">Male</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <label for="goal" style="font-size:13px;font-weight:700">What's your current goal?</label>
            <textarea id="goal" placeholder="e.g. Lose weight, build muscle, get back on track..." style="width:100%;padding:12px 14px;border:1px solid color-mix(in srgb, var(--color-text) 14%, transparent);border-radius:var(--radius-sm);font-size:15px;background:var(--color-bg);color:var(--color-text);resize:vertical;min-height:72px"></textarea>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <label for="symptoms" style="font-size:13px;font-weight:700">Anything else I should know?</label>
            <textarea id="symptoms" placeholder="Health conditions, injuries, medications, etc." style="width:100%;padding:12px 14px;border:1px solid color-mix(in srgb, var(--color-text) 14%, transparent);border-radius:var(--radius-sm);font-size:15px;background:var(--color-bg);color:var(--color-text);resize:vertical;min-height:72px"></textarea>
          </div>
          <button type="submit" id="submit-btn" style="width:100%;padding:15px;border:0;border-radius:var(--radius-sm);font-family:var(--font-body);font-size:16px;font-weight:700;margin-top:6px;background:var(--color-accent);color:var(--color-bg);cursor:pointer">Confirm Booking</button>
          <div id="form-error" hidden style="color:#b3452b;font-size:14px;line-height:1.5"></div>
        </form>
      </div>

      <!-- STEP 3: confirmation -->
      <div id="step-confirm" hidden style="background:var(--color-accent);color:var(--color-bg);border-radius:calc(2 * var(--radius-lg));padding:var(--space-8) var(--space-6);text-align:center;box-shadow:var(--shadow-md)">
        <h2 style="font-size:28px;color:var(--color-bg)">You're booked!</h2>
        <p id="confirm-detail" style="font-size:17px;font-weight:600;margin:16px 0 0;color:var(--color-accent-200)"></p>
        <p style="font-size:15px;line-height:1.6;margin:20px auto 0;max-width:34ch;color:var(--color-bg)">Check your email for the calendar invite with your Google Meet link.</p>
      </div>
    </div>

  </div>
</main>

<footer style="padding:var(--space-6) clamp(20px,5vw,72px);display:flex;flex-direction:column;gap:var(--space-2);font-size:13px;color:color-mix(in srgb, var(--color-text) 70%, transparent)">
  <div style="display:flex;justify-content:flex-end;align-items:center;flex-wrap:wrap;gap:var(--space-4)">
    <a class="btn btn-secondary" href="contact.html" style="display:inline-flex;align-items:center;gap:10px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.8" y="5" width="18.4" height="14" rx="2.4"></rect><path d="m3.4 6.6 8.6 6 8.6-6"></path></svg>Get Newsletter</a>
  </div>
  <p style="margin:0;max-width:none;font-size:12px;line-height:1.6;color:color-mix(in srgb, var(--color-text) 50%, transparent)">Health coaching is not medical advice, diagnosis or treatment. It does not replace care from your doctor or another qualified health professional. Talk to your doctor before making changes to your diet, exercise or medication.</p>
  <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:var(--space-4);font-size:12px">
    <div style="display:flex;gap:var(--space-4);flex-wrap:wrap">
      <a href="#impressum">Impressum</a>
      <a href="#datenschutz">Datenschutzerklärung</a>
    </div>
    <span style="font-size:13px;color:color-mix(in srgb, var(--color-text) 70%, transparent)">© 2026 Healthy with Naudia</span>
  </div>
</footer>

